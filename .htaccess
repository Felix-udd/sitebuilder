Options -Indexes
# Never expose repository metadata or environment/configuration files.
<FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|\.gitattributes|README\.md|schema\.sql|composer\.(?:json|lock)|package(?:-lock)?\.json)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 (?i)/\.git(?:/|$)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
